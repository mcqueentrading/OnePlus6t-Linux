# Maintainer: LinuxPhone project
# Reference: Alpine community/hexagonrpcd 0.4.0-r3

pkgname=hexagonrpcd
pkgver=0.4.0
pkgrel=1
pkgdesc="Qualcomm Hexagon FastRPC filesystem daemon"
arch=('aarch64')
url="https://github.com/linux-msm/hexagonrpc"
license=('GPL-3.0-or-later')
depends=('glibc' 'systemd')
makedepends=('meson' 'ninja' 'linux-headers')
source=("$pkgname-$pkgver.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('fe742549a2672902d59a90dafd741a9a0acbeca059e07ff5130e2b525a66574f')

build() {
  arch-meson "hexagonrpc-$pkgver" build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  DESTDIR="$pkgdir" meson install --no-rebuild -C build

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/10-fastrpc.rules" <<'EOF'
SUBSYSTEM=="misc", KERNEL=="fastrpc-*", OWNER="fastrpc", GROUP="fastrpc", MODE="600"
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/hexagonrpcd.conf" <<'EOF'
u fastrpc - "Qualcomm FastRPC service user" / -
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/hexagonrpcd-sdsp.service" <<'EOF'
[Unit]
Description=Server for FastRPC remote procedure calls from Qualcomm SDSP
ConditionPathExists=/dev/fastrpc-sdsp

[Service]
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-sdsp -d sdsp -s -R /usr/share/qcom/sdm845/OnePlus/oneplus6
Restart=always
RestartSec=3
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/hexagonrpcd-adsp-rootpd.service" <<'EOF'
[Unit]
Description=Server for FastRPC remote procedure calls from Qualcomm ADSP RootPD
Conflicts=suspend.target
Before=suspend.target
ConditionPathExists=!/dev/fastrpc-sdsp
ConditionPathExists=/dev/fastrpc-adsp

[Service]
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -R /usr/share/qcom/sdm845/OnePlus/oneplus6
Restart=always
RestartSec=3
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
EOF

  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/hexagonrpcd-adsp-sensorspd.service" <<'EOF'
[Unit]
Description=Server for FastRPC remote procedure calls from Qualcomm ADSP SensorPD
Conflicts=suspend.target
Before=suspend.target
ConditionPathExists=!/dev/fastrpc-sdsp
ConditionPathExists=/dev/fastrpc-adsp

[Service]
ExecStart=/usr/bin/hexagonrpcd -f /dev/fastrpc-adsp -d adsp -s -R /usr/share/qcom/sdm845/OnePlus/oneplus6
Restart=always
RestartSec=3
User=fastrpc
Group=fastrpc

[Install]
WantedBy=multi-user.target
EOF
}
